{
  "name": "koblich-chronicles-be",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "CI=false PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate && cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:prod": "CI=false PAYLOAD_CONFIG_PATH=src/payload.config.ts yes | payload migrate && cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:test": "CI=false PAYLOAD_CONFIG_PATH=src/payload.config.ts && cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "import-charts": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload run src/scripts/importCharts.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation next lint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:dev": "cross-env NODE_ENV=development PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/email-nodemailer": "^3.85.1",
    "@payloadcms/live-preview-react": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/payload-cloud": "^3.85.1",
    "@payloadcms/plugin-form-builder": "^3.85.1",
    "@payloadcms/plugin-nested-docs": "^3.85.1",
    "@payloadcms/plugin-redirects": "^3.85.1",
    "@payloadcms/plugin-search": "^3.85.1",
    "@payloadcms/plugin-seo": "^3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/ui": "^3.85.1",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.21",
    "express": "^4.22.2",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "lucide-react": "^0.378.0",
    "next": "^15.5.19",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^8.0.11",
    "payload": "^3.85.1",
    "payload-admin-bar": "^1.0.7",
    "pdfkit": "^0.17.2",
    "playwright": "^1.61.1",
    "prism-react-renderer": "^2.4.1",
    "puppeteer": "^24.43.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.45.4",
    "react-toastify": "^11.1.0",
    "sharp": "0.32.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "22.5.4",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "^10.5.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.1.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
