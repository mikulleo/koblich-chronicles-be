# Database connection string
DATABASE_URI=postgres://postgres:<password>@127.0.0.1:5432/your-database-name

# Or use a PG connection string
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# SMTP email configuration (for welcome emails, password resets, etc.)
# Recommended: Resend (free — 100 emails/day) — https://resend.com
# Works with any SMTP provider: Resend, SendGrid, Gmail, etc.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=YOUR_RESEND_API_KEY
SMTP_FROM_ADDRESS=onboarding@resend.dev
SMTP_FROM_NAME=Koblich Chronicles

# PDF export: serve images from local filesystem instead of HTTP
# Set to 'true' on Railway/production where Playwright can't reach the server's own URLs
PDF_USE_LOCAL_IMAGES=false

# Directory where media uploads are stored (used by Payload and PDF export)
# On Railway this is typically the volume mount path, e.g. /app/uploads
# PAYLOAD_UPLOADS_DIR=/app/uploads

# Remote import: when running import-charts locally against the Railway backend,
# set these so media files are uploaded via the REST API instead of the local disk.
# PAYLOAD_SERVER_URL=https://your-app.up.railway.app
# PAYLOAD_ADMIN_EMAIL=your-admin@email.com
# PAYLOAD_ADMIN_PASS=your-admin-password
